{
  "name": "dsh-video-digest",
  "version": "0.2.1",
  "private": false,
  "type": "module",
  "description": "把 B 站视频的「看」这件事拆成一条可核实的本地流水线：字幕 + 画面文字 + 宫格 + 弹幕 → 事实卡 → 门禁 → 总结 → 私信，接进 DeepSeek Harness（DSH）。画面文字支持 Xiaomi-OCR-0（Ollama）与 Windows 自带 OCR 双引擎，自动降级。",
  "keywords": [
    "bilibili",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "ocr",
    "storyboard",
    "summary",
    "video",
    "xiaomi-ocr"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/imxiaocheng-dev/dsh-video-digest"
  },
  "homepage": "https://github.com/imxiaocheng-dev/dsh-video-digest#readme",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.1"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "panel/",
    "scripts/",
    "config/",
    "tools/",
    "vendor/",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-llm": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  }
}
